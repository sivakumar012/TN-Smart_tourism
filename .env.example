# TN Smart Tourism — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Google Analytics 4
# ---------------------------------------------------------------------------
# Obtain your Measurement ID from:
#   Google Analytics → Admin → Data Streams → Web → Measurement ID
#   Format: G-XXXXXXXXXX
#
# Leave empty or unset to disable GA4 tracking (the app remains fully functional).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-C0637BGNB7

# ---------------------------------------------------------------------------
# Analytics environment separation
# ---------------------------------------------------------------------------
# Set to "true" in development and staging to tag events with is_demo=true
# and route them to a separate GA4 test property (recommended).
# In production, set to "false" or omit.
NEXT_PUBLIC_GA_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Node environment (automatically set by Next.js — do not override)
# ---------------------------------------------------------------------------
# NODE_ENV=development
